# Firebase web configuration.
#
# These are PUBLIC identifiers, not secrets: whatever you put here ends up in the
# JavaScript served to the browser. Environment variables keep project ids out of
# git and let dev and production differ — they do not hide anything.
#
# Copy this file to `.env` for local use, then run `npm run config` to write
# firebase-config.js from it. On Netlify, set the same six names under
# Site configuration → Environment variables; the build runs the same script.
#
# Never put a service-account key, admin SDK credential or any server secret in
# here. Those bypass your Firestore rules entirely.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
